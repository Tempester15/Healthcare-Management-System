        <description/>
        <mobile_callable>false</mobile_callable>
        <name>PatientUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var PatientUtils = Class.create();
PatientUtils.prototype = {
	initialize: function (patientId) {
		this.source = new GlideRecord('u_patient_record');
		this.id = patientId;
	},

	fetchAllPatientDetailsByPatientID: function () {
		this.source.get(this.id);
		results = {
			patient_number: this.source.getValue('u_number'),
			patient_user_id: this.source.getValue('u_user_patient'),
			patient_first_name: this.source.getValue('u_first_name'),
			patient_last_name: this.source.getValue('u_last_name'),
			patient_dob: this.source.getValue('u_dob').toString(),
			patient_gender: this.source.getValue('u_gender'),
			patient_status: this.source.getValue('u_status'),
			patient_vip: this.source.getValue('u_vip'),
			patient_contact_number: this.source.getValue('u_contact_number'),
			patient_email: this.source.getValue('u_email'),
			patient_address: this.source.getValue('u_address'),
			patient_emergency_contact_number: this.source.getValue('u_emergency_contact_number'),

		};
		return results;
	},

	checkIfVIP: function () {
		this.source.get(this.id);
		if (this.source.u_vip) {
			return true;
		}
		else {
			return false;
		}
	},

	calculateAge: function () {
		this.source.get(this.id);
		var today = new GlideDate().getDate();
		var patient_dob = this.source.u_dob;
		var age = Math.round(gs.dateDiff(patient_dob, today, true) / (60 * 60 * 24 * 365));
		return age;
	},

	type: 'PatientUtils'
};]]></script>
