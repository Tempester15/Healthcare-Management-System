        <name>FetchRecordsUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var FetchRecordsUtils = Class.create();
FetchRecordsUtils.prototype = {
    initialize: function() {
		this.patientTable = new GlideRecord('u_patient_record');
		this.appointmentTable = new GlideRecord('u_appointments');
		this.medicationTable = new GlideRecord("u_medication");
		this.labTestTable = new GlideRecord('u_lab_test');
		this.doctorTable = new GlideRecord('u_doctor');
		this.nurseTable = new GlideRecord('u_nurse');
		this.wardTable = new GlideRecord('u_ward');
		this.roomTable = new GlideRecord('u_rooms');
		this.billingTable = new GlideRecord('u_billing');
		this.insuranceTable = new GlideRecord('u_insurance');
    },

	fetchAllAppointmentsOfPatient : function(patientId){
		this.patientTable.addQuery('number', patientId);
		this.patientTable.query();
		if(this.patientTable.next()){
			var records = [];
			this.appointmentTable.addQuery('u_patient_id', this.patientTable.sys_id);
			this.appointmentTable.query();
			while(this.appointmentTable.next()){
				records.push({
					app_id : this.appointmentTable.number.toString(),
					app_date : this.appointmentTable.u_appointment_date.toString(),
					app_doctor_id : this.appointmentTable.getDisplayValue('u_doctor_id'),
					app_status : this.appointmentTable.getDisplayValue('u_status')
				});
			}
		}
		return JSON.stringify(records);
	},

    type: 'FetchRecordsUtils'
};]]></script>
