        <name>BusinessRulesUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var BusinessRulesUtils = Class.create();
BusinessRulesUtils.prototype = {
	initialize: function () {

	},

	notifyAssignedDoctor: function (current) {
		gs.eventQueue('notify.assigned.doctor', current, current.u_doctor_id.u_email, null);
	},

	completeAppointment: function (current) {
		var notes = current.work_notes.getJournalEntry(-1);
		notes = notes.split('\n');
		for (var i = 0; i < notes.length; i++) {
			if (notes[i].toLowerCase().includes('appointment is finished') || notes[i].includes('appointment is completed') || notes[i].toLowerCase().includes('finished') || notes[i].toLowerCase().includes('completed')) {
				current.u_status = 'completed';
				current.update();
				return;
			}
		}
	},

	setPriorityIfVIP: function (current) {
		if (current.u_patient_id.u_vip) {
			current.priority = '2';
			current.update();
		}
	},

	calculateTotalDosage: function (current) {
		frqMap = {
			'once_daily': 1,
			'twice_daily': 2,
			'thrice_daily': 3
		};
		var frequency = frqMap[current.getValue('u_frequency')];
		var dosage = Number(current.u_dosage);
		var totalDosage = frequency * dosage;
		current.setValue('u_total_dosage', totalDosage);
	},

	notifyPatientForTestResults: function (current) {
		if (!current.u_results.toLowerCase().includes('awaiting results')) {
			gs.eventQueue('notify_patient_about_test_results', current, current.u_patient_id.u_email, null);
		}
	},

	beforUpdateOccupancyInRoom: function (current, param1 = false) {
		if (!param1) {
			var _cond1 = Number.parseInt(current.u_room_id.u_bed_counts) > Number.parseInt(current.u_room_id.u_occupied_beds);
			if (!_cond1) {
				// gs.addErrorMessage('Invalid Insert');
				current.setAbortAction(true);
			}
			gs.addInfoMessage('results of condition 1 : ' + _cond1);
		}
		else{
			if(_cond1){
				current.u_room_id.u_occupied_beds = Number.parseInt(current.u_room_id.u_occupied_beds) + 1;
				current.u_room_id.update();
			}
		}
	},

	type: 'BusinessRulesUtils'
};]]></script>
