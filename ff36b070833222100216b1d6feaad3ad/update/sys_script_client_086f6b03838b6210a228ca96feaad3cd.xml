        <script><![CDATA[function onLoad() {
   if(!g_form.isNewRecord()){
	var patientId = g_form.getUniqueValue();
	var myPat = new GlideAjax('global.PatientUtilsClient');
	myPat.addParam('sysparm_name', 'fetchPatientDetailsByPatientID');
	myPat.addParam('sysparm_patient_id', patientId);
	myPat.getXMLAnswer(getResponse);
   }

	function getResponse(results){
		var _res = JSON.parse(results);
		g_form.addInfoMessage('Welcome ' + _res.pat_first_name + " " + _res.pat_last_name);
	}
}]]></script>
