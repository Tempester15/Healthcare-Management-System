        <script><![CDATA[var UIActionUtils = Class.create();
UIActionUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	updateAppointmentDate : function(){
		var appointmentSysId = this.getParameter('sysparm_app_id');
		var  newDate = this.getParameter('sysparm_new_date');
		var appointmentGr = new GlideRecord('u_appointments');
		if(appointmentGr.get(appointmentSysId)){
			appointmentGr.setValue('u_appointment_date', newDate);
			appointmentGr.update();
		}
		return;

	},
    type: 'UIActionUtils'
});]]></script>
