        <script><![CDATA[var AppointmentUtilsClient = Class.create();
AppointmentUtilsClient.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {


	getPatientDetailsByPatientSysId : function(){
		var patient_sys_id = this.getParameter('sysparm_patient_id');
		var patientTab = new GlideRecord('u_patient_record');
		if(patientTab.get(patient_sys_id)){
			var result = {
				first_name : patientTab.getValue('u_first_name'),
				last_name : patientTab.getValue('u_last_name'),
				sys_id : patient_sys_id
			};
			return JSON.stringify(result);
		}
		else{
			return null;
		}
		
	},
    type: 'AppointmentUtilsClient'
});]]></script>
